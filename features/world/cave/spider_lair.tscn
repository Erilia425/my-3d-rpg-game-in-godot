npc_name = "The Spider Mother"
role = "Keeper of Unfinished Memories"
greeting_lines = PackedStringArray("My children are not finished memories. They are still becoming.", "The houses sleep on my web. Do not cut the pale strands.", "Lirael Marrow, if you need a name for me. Few do.")
